[Unit]
Description=Humanaize 2.1 AI Assistant with GAN Thinking
Documentation=https://github.com/A113NWu/Humanaize2-Project
After=network.target sound.target

[Service]
Type=simple
User=@@USER_NAME@@
Group=@@USER_GROUP@@
WorkingDirectory=@@INSTALL_DIR@@
ExecStart=@@HOME_DIR@@/.local/bin/humanaize2
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=humanaize2

Environment=HOME=@@HOME_DIR@@
Environment=DISPLAY=:0
Environment=PYTHONUNBUFFERED=1
Environment=PATH=/usr/local/bin:/usr/bin:/bin:~/.local/bin

# Security settings
NoNewPrivileges=false
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@@DATA_DIR@@
ReadWritePaths=@@LOG_DIR@@
ReadWritePaths=@@CONFIG_DIR@@

# Resource limits
MemoryMax=2G
CPUQuota=50%

[Install]
WantedBy=multi-user.target
Alias=humanaize2.service