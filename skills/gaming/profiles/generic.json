{
    "game_name": "Generic",
    "description": "通用游戏配置，适用于大多数键盘控制的游戏",
    "trigger": {
        "window_title": "",
        "match_mode": "contains"
    },
    "controls": [
        {"name": "向上移动", "action": "move_up", "type": "key", "keys": ["w", "arrowup"], "description": "向上移动角色"},
        {"name": "向下移动", "action": "move_down", "type": "key", "keys": ["s", "arrowdown"], "description": "向下移动角色"},
        {"name": "向左移动", "action": "move_left", "type": "key", "keys": ["a", "arrowleft"], "description": "向左移动角色"},
        {"name": "向右移动", "action": "move_right", "type": "key", "keys": ["d", "arrowright"], "description": "向右移动角色"},
        {"name": "跳跃", "action": "jump", "type": "key", "keys": ["space"], "description": "跳跃"},
        {"name": "攻击", "action": "attack", "type": "mouse_click", "button": "left", "description": "左键攻击"},
        {"name": "使用/交互", "action": "use", "type": "mouse_click", "button": "right", "description": "右键使用/交互"},
        {"name": "什么都不做", "action": "do_nothing", "type": "key", "keys": [], "description": "保持当前状态"}
    ],
    "death_detection": {
        "enabled_methods": ["text", "visual_cues"],
        "text": {
            "keywords": ["game over", "gameover", "you died", "you are dead", "你死了", "失败", "死亡", "挑战失败", "关卡失败", "game over!", "you died!", "dead", "defeat", "continue?", "restart", "重试", "重新开始", "gameover!", "defeat!", "lost"],
            "enabled": true
        },
        "health_bar": {
            "enabled": false
        },
        "scene_change": {
            "enabled": false,
            "threshold": 30
        },
        "visual_cues": {
            "enabled": true,
            "confidence_threshold": 0.7
        }
    },
    "ui_regions": {},
    "tips": [
        "这是通用配置，适用于大多数游戏",
        "如果游戏有特殊操作，请创建自定义配置文件"
    ]
}