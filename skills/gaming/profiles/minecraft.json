{
    "game_name": "Minecraft",
    "description": "我的世界游戏配置",
    "trigger": {
        "window_title": "Minecraft",
        "match_mode": "contains"
    },
    "controls": [
        {"name": "向前移动", "action": "move_forward", "type": "key", "keys": ["w"], "description": "向前移动"},
        {"name": "向后移动", "action": "move_backward", "type": "key", "keys": ["s"], "description": "向后移动"},
        {"name": "向左移动", "action": "move_left", "type": "key", "keys": ["a"], "description": "向左移动"},
        {"name": "向右移动", "action": "move_right", "type": "key", "keys": ["d"], "description": "向右移动"},
        {"name": "跳跃", "action": "jump", "type": "key", "keys": ["space"], "description": "跳跃"},
        {"name": "冲刺", "action": "sprint", "type": "key", "keys": ["leftshift"], "description": "冲刺加速"},
        {"name": "潜行", "action": "sneak", "type": "key", "keys": ["leftcontrol"], "description": "潜行（缓慢移动）"},
        {"name": "攻击/破坏", "action": "attack", "type": "mouse_click", "button": "left", "description": "左键攻击或破坏方块"},
        {"name": "放置/使用", "action": "use", "type": "mouse_click", "button": "right", "description": "右键放置方块或使用物品"},
        {"name": "打开背包", "action": "inventory", "type": "key", "keys": ["e"], "description": "打开背包界面"},
        {"name": "切换物品", "action": "switch_item", "type": "key", "keys": ["1", "2", "3", "4", "5", "6", "7", "8", "9"], "description": "切换快捷栏物品"},
        {"name": "丢弃物品", "action": "drop", "type": "key", "keys": ["q"], "description": "丢弃手中物品"},
        {"name": "什么都不做", "action": "do_nothing", "type": "key", "keys": [], "description": "保持当前状态"}
    ],
    "death_detection": {
        "enabled_methods": ["text", "scene_change", "visual_cues"],
        "text": {
            "keywords": ["you died!", "you have died", "你死了", "game over", "respawn", "重生", "重新开始"],
            "enabled": true
        },
        "health_bar": {
            "enabled": false
        },
        "scene_change": {
            "enabled": true,
            "threshold": 40
        },
        "visual_cues": {
            "enabled": true,
            "confidence_threshold": 0.7
        }
    },
    "ui_regions": {},
    "tips": [
        "Minecraft使用WASD移动，空格键跳跃",
        "左键破坏方块，右键放置方块",
        "按E打开背包",
        "数字键1-9切换物品",
        "注意保持生命值和饥饿值"
    ]
}